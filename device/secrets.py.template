# Copy this file to secrets.py and fill in your values.
# secrets.py is gitignored and must never be committed.

secrets = {
    # Wi-Fi
    "ssid":     "YOUR_WIFI_SSID",
    "password": "YOUR_WIFI_PASSWORD",

    # Weather — https://openweathermap.org/api (free tier is fine)
    "openweather_key": "YOUR_OPENWEATHERMAP_API_KEY",

    # Tides — no key needed; find your station at
    # https://tidesandcurrents.noaa.gov/stations.html
    "noaa_station": "8443970",

    # Your location (decimal degrees)
    "latitude":  42.36,
    "longitude": -71.06,

    # Static UTC offset used at boot only — the device re-syncs to the
    # accurate (DST-aware) offset on every weather fetch, so this just
    # needs to be roughly right. e.g. -5 for US Eastern, -8 for US Pacific,
    # 0 for UTC, +1 for Central Europe.
    "tz_offset_hours": -5,

    # Raspberry Pi proxy address — required for planes and ships
    # Run proxy/server.py on a Pi on your local network
    "proxy_host": "http://YOUR_PI_IP:6590",

    # Shared secret sent as X-Device-Secret when POSTing logs to the proxy.
    # Must match device_secret in proxy/config.json. Leave blank to disable.
    "device_secret": "",

    # Named location for the proxy's v2 API. Leave blank to use the proxy's
    # home location (v1 endpoints) — keep this empty if you have a single
    # display sharing the proxy's bounding box. Set to a key from the proxy's
    # `locations` config block (e.g. "home", "beach") to point this display
    # at a different lat/lon/bbox without touching the proxy's defaults.
    "location": "",

    # Left column content. "tides" = water + weather sky + ship (default).
    # "sky" = moon phase view, no tide fetches. Use "sky" for inland displays.
    "basin_mode": "tides",

    # --- Panel size ---------------------------------------------------------
    # "64x32"  (default) native 64x32 layout
    # "128x64" native full-panel layout (scale=2 + wide astronomy/forecast)
    # code.py launches the matching layout module for the size you set here.
    "display": "64x32",

    # --- Feature flags ------------------------------------------------------
    # Turn each capability on/off independently. Omit a key to use its default
    # (shown below). enable_astronomy applies only to the 128x64 layout.
    "enable_weather":   True,    # temperature / condition / wind
    "enable_tide":      True,    # tide basin + tide times (coastal displays)
    "enable_planes":    True,    # overhead aircraft screen
    "enable_boats":     True,    # nearby AIS vessels (coastal displays)
    "enable_astronomy": False,   # 128x64 only: sky map / planets / forecast
    "enable_status":    False,   # 128x64 only: cloud/dev provider outage board
}
