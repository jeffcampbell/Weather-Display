  "_locations_comment": "Named locations, selected per request with ?loc=<name>. Omitting loc uses the latitude/longitude/bbox above, reported as the location \"default\". Each entry may set lat, lon and bbox; omitted keys fall back to the globals. Optional per-location keys: ship_radius_mi opts the location in to AIS ship tracking (and sets its display radius in miles) - only opted-in locations are subscribed on AISStream, so an inland location costs no bandwidth; changing it needs a service restart because the subscription is fixed at connect time.",
  "locations": {
    "home": { "lat": 42.36, "lon": -71.06, "bbox": 0.1 },
    "_shore_example": { "lat": 42.14, "lon": -70.69, "bbox": 0.07, "ship_radius_mi": 10, "station": "8443970" }
  },

  "openweather_key": "YOUR_OPENWEATHERMAP_API_KEY",

  "_noaa_station_comment": "Default NOAA CO-OPS station for /api/tides if the device omits ?station=. Must be a harmonic/reference station (has full predictions), not a subordinate/offset-only station.",
  "noaa_station": "8443970",

  "opensky_client_id":     "YOUR_OPENSKY_CLIENT_ID",
  "opensky_client_secret": "YOUR_OPENSKY_CLIENT_SECRET",

  "aisstream_key": "YOUR_AISSTREAM_API_KEY",

  "flightaware_key": "",

  "_flightaware_monthly_limit_comment": "Hard ceiling on billable FlightAware AeroAPI /flights lookups per calendar month (UTC). Persisted to flightaware_usage.json so a restart can't reset it mid-month; once hit, /api/route serves from the free sources only. Default 450 keeps spend under the ~$5/mo free tier at ~1c/query.",
  "flightaware_monthly_limit": 450,

  "_flightaware_alert_thresholds_comment": "Billable-call counts at which the proxy logs a budget warning to the system journal (syslog, ident \"matrix-portal-proxy\"), the first time each is crossed in a month. The highest one logs at ERR, earlier ones at WARNING. Purely informational - thresholds never gate a call; only flightaware_monthly_limit does. Keep them proportional to that limit if you change it.",
  "flightaware_alert_thresholds": [1000, 1800],

  "_flightaware_override_free_routes_comment": "When true (default), FlightAware overrides a route the free DBs already resolved, fixing stale 'right tail, wrong route' answers from reused callsigns. Costs one FA lookup per airframe per cache window (bounded by the monthly limit above). Set false to only consult FlightAware when the free sources found nothing.",
  "flightaware_override_free_routes": true,

  "_route_code_aliases_comment": "Airport codes to rewrite in a resolved /api/route leg, applied uniformly across all upstream sources (OpenSky, adsbdb, FlightAware) right before the route is cached and returned. Exact, case-sensitive match on the code as the source reports it (which may be ICAO, e.g. KDJT, rather than IATA). Default rewrites DJT -> PBI (its former airport code).",
  "route_code_aliases": {"DJT": "PBI"},

  "_route_geo_check_comment": "Geographic plausibility check on the free-tier route (OpenSky/adsbdb): a narrower, self-limiting alternative to flightaware_override_free_routes for deciding when to pay for FlightAware. Looks up origin/destination ICAO longitudes in airport_coords.csv; if the observer's longitude doesn't fall between them (plus route_geo_check_deadband_deg slack), the free route is treated as likely stale. Unknown airports or a disabled check always fail open. route_geo_check_mode: 'off' disables it; 'observe' (default) computes and logs but never gates spend; 'enforce' lets a flagged verdict trigger a paid call. Ship in 'observe', check /api/health route_geo_checks_* plus 'route geo-check:' lines in device.log for at least a week, then flip to 'enforce' once route_geo_check_deadband_deg looks right.",
  "route_geo_check_mode": "observe",
  "route_geo_check_deadband_deg": 0.5,

  "_device_secret_comment": "Shared secret the device must send as X-Device-Secret on POST /api/devicelog. Leave blank to disable the check.",
  "device_secret": "",

  "_calendar_ics_urls_comment": "Private .ics feeds for /api/calendar (the today/tomorrow agenda view). In Google Calendar: Settings -> <calendar> -> Integrate calendar -> 'Secret address in iCal format'. Add as many as you like; the endpoint pools their events and never reports which calendar an event came from. TREAT EACH URL AS A PASSWORD - anyone holding one can read that whole calendar. Leave the list empty to disable the endpoint.",
  "calendar_ics_urls": [],

  "_timezone_comment": "IANA timezone name that /api/calendar measures 'today' and 'tomorrow' in. Omit to use the host's own timezone (/etc/timezone), which is normally what you want.",
  "timezone": "",

  "_status_providers_comment": "Providers monitored by /api/status (the 128x64 outage board). type 'statuspage' is fully config-driven — add any Atlassian Statuspage site with just name+host, no code. type 'aws'/'gcp'/'azure' use built-in adapters (host ignored). Omit this key to use the built-in default set below.",
  "status_providers": [
